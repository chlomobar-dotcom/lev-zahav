# =============================================================================
#  LEV ZAHAV — Variables d'environnement
# -----------------------------------------------------------------------------
#  Copiez ce fichier vers .env.local pour le développement local,
#  et ajoutez ces variables dans Vercel (Settings → Environment Variables)
#  pour la production.
# =============================================================================

# --- Authentification (espace administrateur) --------------------------------
# Nom d'utilisateur pour se connecter à /admin
ADMIN_USERNAME=admin

# Hash bcrypt du mot de passe (générez-le avec : npm run hash-password "MotDePasse")
ADMIN_PASSWORD_HASH=

# Secret pour signer les sessions (générez avec : openssl rand -base64 32)
NEXTAUTH_SECRET=

# URL publique du site (https://levzahav.fr en prod, http://localhost:3000 en dev)
NEXTAUTH_URL=http://localhost:3000

# --- Stockage des photos (Vercel Blob) ---------------------------------------
# Token créé depuis le dashboard Vercel : Storage → Create → Blob
# Sur Vercel cette variable est ajoutée automatiquement lors de la création du Blob store
BLOB_READ_WRITE_TOKEN=

# --- Formulaires (Formspree) -------------------------------------------------
# Identifiants des formulaires Formspree (1 par formulaire).
# Créez un compte sur https://formspree.io, créez un formulaire, copiez son ID
# (la partie après /f/ dans l'URL d'action). Préfixe NEXT_PUBLIC_ obligatoire :
# les formulaires sont envoyés côté navigateur.
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=
NEXT_PUBLIC_FORMSPREE_VOLUNTEER_ID=
NEXT_PUBLIC_FORMSPREE_KAPPAROT_ID=
